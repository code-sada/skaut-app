datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Patrol {
  id          String    @id @default(cuid())
  name        String    @unique
  schedule    String?   // Např. "Středa 16:30 - 18:00"
  location    String?   // Např. "Klubovna"
  
  users       User[]
  
  // Tyto dva řádky Prismě chyběly pro propojení:
  events      Event[]
  meetings    Meeting[]
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  name               String
  role               String       @default("MEMBER")
  createdAt          DateTime     @default(now())
  patrolId           String?
  patrol             Patrol?      @relation(fields: [patrolId], references: [id])
  createdEvents      Event[]
  attendance         Attendance[]
  mustChangePassword Boolean      @default(true)
  meetingAttendance  MeetingAttendance[]
  meetingMessages    MeetingMessage[]
  
  birthDate          DateTime?
  healthNote         String?
  
  parentPhone        String?
  motherName         String?
  motherPhone        String?
  fatherName         String?
  fatherPhone        String?
  otherGuardianName  String?
  otherGuardianPhone String?
  
  parents            User[]       @relation("FamilyRelation")
  children           User[]       @relation("FamilyRelation")

  siblings           User[]       @relation("Siblings")
  siblingOf          User[]       @relation("Siblings")

  pendingUpdates     PendingUpdate[]
  notifications      Notification[] // NOVÉ: Vazba na upozornění
  
  address             String?
  city                String?
  postalCode          String?
  dietaryRestrictions String?
}

model Event {
  id              String       @id @default(uuid())
  title           String
  description     String
  location        String
  
  date            DateTime     
  dateEnd         DateTime?    
  meetingPoint    String?      
  returnPoint     String?      
  
  targetPatrol    String       @default("Všichni")
  rsvpDeadline    DateTime?    
  capacity        Int?         
  
  priceChildren   Int          @default(0)
  priceOlder      Int          @default(0)
  paymentDeadline DateTime?    
  paymentMethod   String?      
  
  equipment       String?      
  food            String?      
  accommodation   String?      
  
  leaderInCharge  String?      
  leaderContact   String?      

  createdAt       DateTime     @default(now())
  isForAll        Boolean      @default(true) 
  allowedPatrols  Patrol[]
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  attendance      Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  status    String   @default("PENDING") 
  note      String?  
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([userId, eventId]) 
}

model Meeting {
  id          String   @id @default(uuid())
  title       String   
  date        DateTime 
  endTime     String   
  location    String   @default("Klubovna")
  comment     String?
  
  patrolId    String
  patrol      Patrol   @relation(fields: [patrolId], references: [id])
  
  attendance  MeetingAttendance[]
  messages    MeetingMessage[]
  
  createdAt   DateTime @default(now())
}

model MeetingAttendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status    String   
  note      String?  
  updatedAt DateTime @updatedAt
  
  @@unique([userId, meetingId])
}

model MeetingMessage {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PendingUpdate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedBy String
  data        String   
  createdAt   DateTime @default(now())
}

// NOVÝ MODEL PRO ZVONEČEK
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  name      String
  url       String
  category  String   // Např. "Pro vedoucí", "Tábor", "Přihlášky"
  type      String   @default("pdf") // "pdf" nebo "link"
  createdAt DateTime @default(now())
}