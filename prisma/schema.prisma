datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Patrol {
  id      String  @id @default(uuid())
  name    String  @unique 
  users   User[]          
  events  Event[]    
  meetings Meeting[]      
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  name               String
  role               String       @default("MEMBER")
  createdAt          DateTime     @default(now())
  patrolId           String?
  patrol             Patrol?      @relation(fields: [patrolId], references: [id])
  createdEvents      Event[]
  attendance         Attendance[]
  mustChangePassword Boolean      @default(true)
  meetingAttendance MeetingAttendance[]
  meetingMessages MeetingMessage[]
}

model Event {
  id              String       @id @default(uuid())
  title           String
  description     String
  location        String
  
  // -- Časový harmonogram --
  date            DateTime     // Začátek akce
  dateEnd         DateTime?    // Konec akce
  meetingPoint    String?      // Kde a v kolik je sraz
  returnPoint     String?      // Kde a v kolik je návrat
  
  // -- Účast a termíny --
  targetPatrol    String       @default("Všichni")
  rsvpDeadline    DateTime?    // Do kdy se přihlásit
  capacity        Int?         // Maximální kapacita
  
  // -- Finance --
  priceChildren   Int          @default(0)
  priceOlder      Int          @default(0)
  paymentDeadline DateTime?    // Do kdy zaplatit
  paymentMethod   String?      // Způsob platby (hotově, účet...)
  
  // -- Logistika --
  equipment       String?      // Co s sebou
  food            String?      // Strava
  accommodation   String?      // Ubytování
  
  // -- Kontakty --
  leaderInCharge  String?      // Zodpovědný vedoucí
  leaderContact   String?      // Kontakt (telefon/email)

  // -- Vztahy a metadata --
  createdAt       DateTime     @default(now())
  isForAll        Boolean      @default(true) 
  allowedPatrols  Patrol[]
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  attendance      Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  status    String   @default("PENDING") 
  note      String?  // <--- Poznámka od rodičů (alergie, odvoz...)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([userId, eventId]) 
}

model Meeting {
  id          String   @id @default(uuid())
  title       String   // Např. "Schůzka Vlků"
  date        DateTime // PŘESNÉ datum a čas začátku (pro ten 2h limit)
  endTime     String   // Čas konce (např. "18:00")
  location    String   @default("Klubovna")
  comment     String?
  
  patrolId    String
  patrol      Patrol   @relation(fields: [patrolId], references: [id])
  
  attendance  MeetingAttendance[]
  messages    MeetingMessage[]
  
  createdAt   DateTime @default(now())
}

model MeetingAttendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status    String   // "GOING", "NOT_GOING"
  note      String?  // Omluvenka
  updatedAt DateTime @updatedAt
  
  @@unique([userId, meetingId])
}

model MeetingMessage {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}